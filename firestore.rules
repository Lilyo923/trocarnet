rules_version = '2';

// Règles de sécurité Firestore pour Trocarnet.
// À coller dans la console Firebase : Firestore Database > Règles > Publier.
//
// Principe : une session = un document sessions/{code}. On peut lire ou
// écrire une session seulement si on connaît son code exact (24 caractères).
// Impossible de lister les sessions des autres ou d'en supprimer une.

service cloud.firestore {
  match /databases/{database}/documents {

    function validId(id) {
      return id.matches('^[A-Za-z0-9]{24}$');
    }

    function validSession(data) {
      return data.keys().hasOnly(['entries', 'tombstones', 'updatedAt', 'appVersion'])
        && data.entries is list
        && data.entries.size() <= 3000
        && data.tombstones is map
        && data.updatedAt is int;
    }

    match /sessions/{sessionId} {
      allow get: if validId(sessionId);
      allow create, update: if validId(sessionId) && validSession(request.resource.data);
      allow list, delete: if false;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
